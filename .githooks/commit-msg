#!/usr/bin/env sh
# Git commit-msg hook
# Validates strict standard: <scope>: <subject>

# Set up colors
RED_BOLD="\033[1;31m"
GREEN_BOLD="\033[1;32m"
BLUE_BOLD="\033[1;34m"
GOLD_BOLD="\033[1;33m"
WHITE_BOLD="\033[1;37m"
RESET="\033[0m"

# Get the current branch name
branch="$(git branch --show-current)"

# Bypass if dev/
case "$branch" in
  dev/*)
    exit 0
    ;;
esac

printf "${BLUE_BOLD}Running commit-msg checks...${RESET}\n"

msg_file="$1"
# Read first line and full message (without CRLF)
msg="$(head -n 1 "$msg_file" | tr -d '\r')"

# GitHub appends this to the subject on squash merge, e.g. "fix bug (#42)".
# Keep in sync with SQUASH_SUFFIX in .github/commitlint/commitlint.config.mjs.
is_squash_merge=0
msg_no_suffix="$msg"
if echo "$msg" | grep -Eq ' \(#[0-9]+\)$'; then
    is_squash_merge=1
    msg_no_suffix="${msg% (#*)}"
fi

# Max length <= 72 (squash-merge commits are exempt — a merge can bundle
# several original commits' worth of subject text)
if [ "$is_squash_merge" -eq 0 ]; then
    len=${#msg}
    if [ "$len" -gt 72 ]; then
        printf "${RED_BOLD}Commit message exceeds 72 characters (actual: $len).${RESET}\n"
        exit 1
    fi
fi

# Format strict regex
# Using POSIX grep
if ! echo "$msg" | grep -Eq '^([a-z0-9/-]+): (.*)$'; then
    printf "${RED_BOLD}Commit message does not match the strict format: <scope>: <subject>${RESET}\n"
    exit 1
fi

# No double spaces
if echo "$msg" | grep -Eq '  +'; then
    printf "${RED_BOLD}Commit message contains multiple consecutive spaces.${RESET}\n"
    exit 1
fi

# Last character must be a letter or a number (ignoring a squash-merge suffix)
if ! echo "$msg_no_suffix" | grep -Eq '[a-zA-Z0-9]$'; then
    printf "${RED_BOLD}Commit message must end with a letter or a number.${RESET}\n"
    exit 1
fi

# Extract subject and first word to check lowercase and imperative mood
subject="${msg#*: }"
first_word="${subject%% *}"

# Check that the first word is strictly lowercase
if printf "%s" "$first_word" | grep -q '[A-Z]'; then
    printf "${RED_BOLD}The first word of the subject ('%s') must be in lowercase.${RESET}\n" "$first_word"
    exit 1
fi

# Basic check for imperative mood (not ending in -ed, -ing, or third-person -s)
# Uses es$|[^s]s$ to avoid rejecting imperatives that end in double-s (address, process, compress)
if printf "%s" "$first_word" | grep -Eq '(ed|ing|es|[^s]s)$' && ! printf "%s" "$first_word" | grep -Eq '^(pass|focus|bypass|alias|express|bring|string|ring|spring|swing|sing)$'; then
    printf "${RED_BOLD}The first word of the subject ('%s') must be in the imperative mood (e.g., 'remove' instead of 'removed' or 'removes').${RESET}\n" "$first_word"
    exit 1
fi

printf "${GREEN_BOLD}All commit-msg checks passed successfully!${RESET}\n"

# Output success
exit 0
